<?xml version="1.0" encoding="utf-8"?>
<!-- Produktuaren izena eta hasierako zenbatekoa sartzeko pantaila. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#464646"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:labelFor="@id/edtProduktua"
        android:text="@string/produktuaren_izena"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/edtProduktua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginHorizontal="12dp"
        android:hint="@string/produktuaren_izena_hint"
        android:inputType="textCapSentences"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:labelFor="@id/edtZenbatekoa"
        android:text="@string/zenbatekoa_etiketa"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/edtZenbatekoa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginHorizontal="12dp"
        android:hint="@string/zenbatekoa_hint"
        android:inputType="numberDecimal"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0" />

    <Button
        android:id="@+id/btnBEZ"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="16dp"
        android:text="@string/bez_botoia" />
</LinearLayout>
