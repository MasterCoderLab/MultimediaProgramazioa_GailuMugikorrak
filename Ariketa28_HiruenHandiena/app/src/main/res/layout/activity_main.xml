<?xml version="1.0" encoding="utf-8"?>
<!-- Ariketa 28: hiru zenbakiak sartzeko pantaila, irakaslearen ereduan oinarrituta. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Egoera-barraren atzealdea. -->
    <View
        android:id="@+id/fondoBarraEstado"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="#212121" />

    <!-- Goiburua, irakaslearen ereduko urdinarekin. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="#3F51B5"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp">

            <!-- Erabiltzailearentzako izenburua. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/izenburua"
                android:textSize="24sp"
                android:textColor="#212121" />

            <!-- Lehenengo zenbakia: zenbaki oso positiboak eta negatiboak. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:labelFor="@id/edtLehena"
                    android:text="@string/lehena_etiketa"
                    android:textColor="#212121"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/edtLehena"
                    android:layout_width="112dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:inputType="numberSigned"
                    android:singleLine="true"
                    android:textColor="#212121"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Bigarren zenbakia. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:labelFor="@id/edtBigarrena"
                    android:text="@string/bigarrena_etiketa"
                    android:textColor="#212121"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/edtBigarrena"
                    android:layout_width="112dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:inputType="numberSigned"
                    android:singleLine="true"
                    android:textColor="#212121"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Hirugarren zenbakia. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:labelFor="@id/edtHirugarrena"
                    android:text="@string/hirugarrena_etiketa"
                    android:textColor="#212121"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/edtHirugarrena"
                    android:layout_width="112dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:inputType="numberSigned"
                    android:singleLine="true"
                    android:textColor="#212121"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Erakutsi botoi bakarra, irakaslearen pantaila bezala. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnErakutsi"
                android:layout_width="116dp"
                android:layout_height="52dp"
                android:layout_gravity="end"
                android:background="@drawable/botoi_urdina"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="@string/erakutsi"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Kalkuluaren emaitza. -->
            <TextView
                android:id="@+id/txtEmaitza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:textColor="#212121"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
