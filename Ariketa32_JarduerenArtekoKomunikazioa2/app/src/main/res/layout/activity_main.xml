<?xml version="1.0" encoding="utf-8"?>
<!-- Jarduera nagusia: izena bidaltzeko eremuak eta jasotako emaitza. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010"
    android:fitsSystemWindows="true">

    <!-- Jatorrizko ariketaren goiko izenburua mantentzen da. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#464646"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txtIzenaEtiketa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:labelFor="@id/edtIzena"
        android:text="@string/izena_etiketa"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/edtIzena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginHorizontal="12dp"
        android:inputType="textPersonName"
        android:singleLine="true"
        android:hint="@string/izena_iradokizuna"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0" />

    <Button
        android:id="@+id/btnEgiaztatu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:text="@string/egiaztatu"
        android:textAllCaps="false" />

    <!-- Bigarren jardueratik itzulitako String-a hemen erakusten da. -->
    <TextView
        android:id="@+id/txtEmaitza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:text="@string/hasierako_emaitza"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />
</LinearLayout>
