<?xml version="1.0" encoding="utf-8"?>
<!-- Bigarren jarduera: baldintzen galdera eta bi erantzun-botoiak. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bigarrenMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#464646"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <!-- Izenarekin osatutako baldintzen galdera. -->
    <TextView
        android:id="@+id/txtGaldera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"
        android:text="@string/hasierako_galdera"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btnOnartu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:text="@string/onartu_botoia"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnBaztertu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:text="@string/baztertu_botoia"
        android:textAllCaps="false" />
</LinearLayout>
