<?xml version="1.0" encoding="utf-8"?>

<!--
    AndroidManifest.xml fitxategiak aplikazioaren oinarrizko konfigurazioa definitzen du.
    Bertan aplikazioaren jarduerak, baimenak eta ezaugarri nagusiak erregistratzen dira.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Aplikazioaren konfigurazio orokorra.
        Ikonoa, izena, backup konfigurazioa eta gai nagusia definitzen dira.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ariketa20_Asteroideak">

        <!--
            "Acerca de..." informazioa bistaratzen duen jarduera.
            Jarduera hau Manifest fitxategian erregistratu behar da
            Intent baten bidez ireki ahal izateko.
        -->
        <activity
            android:name=".AcercaDeActivity"
            android:label="Acerca de ..." />

        <!--
            Aplikazioaren jarduera nagusia.
            exported="true" atributuak Android sistemari jarduera hau
            aplikazioaren kanpotik abiarazi daitekeela adierazten dio.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <!--
                Intent-filter honek MainActivity aplikazioaren
                hasierako jarduera dela adierazten du.
            -->
            <intent-filter>

                <!-- Aplikazioa abiarazteko ekintza nagusia. -->
                <action android:name="android.intent.action.MAIN" />

                <!--
                    Jarduera hau aplikazio-abiarazlean agertuko dela
                    adierazten du.
                -->
                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

    </application>

</manifest>