<?xml version="1.0" encoding="utf-8"?>
<!-- Irakaslearen RadioGroup eredua: lau eragiketa, bi sarrera eta bi botoi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Sistemaren goiko egoera-barraren kolorea. -->
    <View
        android:id="@+id/fondoBarraEstado"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="#212121" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#3F51B5"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Eragiketa bakarra hautatzeko aukera. -->
            <RadioGroup
                android:id="@+id/rdgEragiketak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="30dp">

                <RadioButton
                    android:id="@+id/rdbBatuketa"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/batuketa"
                    android:textSize="17sp"
                    android:textColor="#212121" />

                <RadioButton
                    android:id="@+id/rdbKenketa"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/kenketa"
                    android:textSize="17sp"
                    android:textColor="#212121" />

                <RadioButton
                    android:id="@+id/rdbBiderketa"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/biderketa"
                    android:textSize="17sp"
                    android:textColor="#212121" />

                <RadioButton
                    android:id="@+id/rdbZatiketa"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/zatiketa"
                    android:textSize="17sp"
                    android:textColor="#212121" />
            </RadioGroup>

            <!-- Zenbaki naturalak sartzeko bi eremuak. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginEnd="12dp"
                    android:text="@string/lehen_zenbakia"
                    android:textColor="#212121"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/edtNum1"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:singleLine="true"
                    android:inputType="number"
                    android:hint="@string/zenbaki_iradokizuna"
                    android:textSize="18sp"
                    android:textColor="#212121" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginEnd="12dp"
                    android:text="@string/bigarren_zenbakia"
                    android:textColor="#212121"
                    android:textSize="18sp" />
                <EditText
                    android:id="@+id/edtNum2"
                    android:layout_width="132dp"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:singleLine="true"
                    android:inputType="number"
                    android:hint="@string/zenbaki_iradokizuna"
                    android:textSize="18sp"
                    android:textColor="#212121" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGarbitu"
                    android:layout_width="112dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/botoi_urdina"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="@string/garbitu"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:stateListAnimator="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnKalkulatu"
                    android:layout_width="112dp"
                    android:layout_height="52dp"
                    android:background="@drawable/botoi_urdina"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:text="@string/kalkulatu"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Emaitza ezkutatuta dago kalkulu bat egin arte. -->
            <TextView
                android:id="@+id/txtEmaitza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:textColor="#303F9F"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
