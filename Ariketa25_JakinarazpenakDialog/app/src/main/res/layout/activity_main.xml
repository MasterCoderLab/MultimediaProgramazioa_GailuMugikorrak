<?xml version="1.0" encoding="utf-8"?>

<!-- Irakaslearen jatorrizko egitura: lau botoi eta 5dp-ko tartea. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/LinearLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp"
    android:gravity="center">

    <!-- Alerta-elkarrizketa irekitzen du. -->
    <Button
        android:id="@+id/BtnAlerta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/botoi_alerta" />

    <!-- Berrespen-elkarrizketa irekitzen du. -->
    <Button
        android:id="@+id/BtnConfirmacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/botoi_confirmacion" />

    <!-- Hizkuntza bakarra hautatzeko elkarrizketa irekitzen du. -->
    <Button
        android:id="@+id/BtnSeleccionSimple"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/botoi_seleccion_simple" />

    <!-- Hainbat hizkuntza hautatzeko elkarrizketa irekitzen du. -->
    <Button
        android:id="@+id/BtnSeleccionMultiple"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/botoi_seleccion_multiple" />

</LinearLayout>
